# Caddy tự xin & gia hạn chứng chỉ Let's Encrypt cho các subdomain.
# Các biến {$...} lấy từ environment của container caddy (xem docker-compose.prod.yml).

{
	email {$ACME_EMAIL}
}

# Frontend (UI tĩnh phục vụ bởi nginx)
{$APP_DOMAIN} {
	encode gzip zstd
	reverse_proxy ui:80
}

# Backend API (.NET Kestrel cổng 8080)
{$API_DOMAIN} {
	encode gzip zstd
	reverse_proxy api:8080
}

# UI kiosk quét khuôn mặt. HTTPS là bắt buộc: getUserMedia chỉ hoạt động trên
# secure context, mở qua http hay qua IP thuần là camera không bật được.
# Domain đặt cứng (không phải secret) để khỏi phải khai lại trong .env.
kiosk.operix.fun {
	encode gzip zstd
	reverse_proxy attendance-ui:80
}

# AI service. /process_frame, /extract_embedding, /reload_employees KHÔNG có auth,
# nên chặn theo IP ở đây là lớp bảo vệ duy nhất — chỉ mạng công ty gọi được.
# route{} để giữ đúng thứ tự viết (mặc định Caddy tự sắp xếp lại directive).
ai.operix.fun {
	encode gzip zstd
	route {
		@blocked not remote_ip {$AI_ALLOWED_IPS}
		respond @blocked "Forbidden" 403
		reverse_proxy attendance-ai:5002
	}
}

# MinIO — phục vụ presigned URL cho trình duyệt (ảnh khuôn mặt, file hợp đồng).
# Caddy giữ nguyên Host header khi forward → chữ ký SigV4 (ký theo Minio__ExternalEndpoint
# = giá trị {$S3_DOMAIN}) khớp với Host mà MinIO nhận được.
{$S3_DOMAIN} {
	encode gzip zstd
	reverse_proxy minio:9000
}
