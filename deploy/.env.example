# ============================================================
# Mingo Payroll — biến môi trường production (ĐÃ ĐIỀN SẴN)
#
# Trên VPS: cp .env.example .env  (là dùng được ngay).
# ⚠️ File này chứa secret thật -> GIỮ REPO Ở CHẾ ĐỘ PRIVATE.
#    Nếu sau này repo công khai, hãy rotate lại toàn bộ mật khẩu/khóa bên dưới.
#    File .env thật trên VPS đã được .gitignore, không bị commit.
# ============================================================

# ===== Registry & image =====
REGISTRY_OWNER=luans1mple
IMAGE_TAG=latest

# ===== Domain (Caddy / TLS) =====
APP_DOMAIN=app.operix.fun
API_DOMAIN=api.operix.fun
# Subdomain công khai cho MinIO (presigned URL ảnh/file). Trỏ DNS về VPS như 2 domain trên.
S3_DOMAIN=s3.operix.fun
ACME_EMAIL=luans1mple2004@gmail.com

# ===== SQL Server =====
MSSQL_SA_PASSWORD=***REMOVED***

# ===== MinIO =====
MINIO_ROOT_USER=mingoadmin
MINIO_ROOT_PASSWORD=***REMOVED***
MINIO_BUCKET=mps-storage
MINIO_BACKEND_USER=backend
MINIO_BACKEND_PASSWORD=***REMOVED***

# ============================================================
# Cấu hình ứng dụng .NET — ASP.NET Core đọc theo convention Section__Key
# (nạp vào container api qua env_file)
# ============================================================
ASPNETCORE_ENVIRONMENT=Production

# Kết nối DB — Server=sqlserver là tên service trong compose;
# password PHẢI khớp MSSQL_SA_PASSWORD ở trên.
ConnectionStrings__DefaultConnection=Server=sqlserver;Database=MPS_Db;User Id=sa;Password=***REMOVED***;TrustServerCertificate=True;

# JWT (khóa ngẫu nhiên >=32 byte)
Jwt__SecretKey=REPLACE_WITH_AT_LEAST_32_BYTE_SECRET_FROM_ENV

# Tài khoản seed mặc định (đăng nhập lần đầu bằng admin / mật khẩu này)
DefaultAdmin__Password=***REMOVED***
DefaultRoleUsers__Password=***REMOVED***

# FPT AI OCR (dùng lại key hiện có)
FptAiOcr__ApiKey=***REMOVED***

# SMTP (dùng lại Gmail App Password hiện có)
Smtp__Username=thangvd189003@gmail.com
Smtp__Password=***REMOVED***
Smtp__FromEmail=thangvd189003@gmail.com
Smtp__LoginUrl=https://app.operix.fun/login

# MinIO — khớp với MINIO_BACKEND_* ở trên; Endpoint là tên service nội bộ
Minio__Endpoint=minio:9000
Minio__AccessKey=backend
Minio__SecretKey=***REMOVED***
Minio__DefaultBucket=mps-storage
Minio__UseSsl=false
# Host trình duyệt gọi để tải presigned URL — PHẢI khớp S3_DOMAIN (Caddy proxy TLS → minio:9000).
# Presigned URL được ký theo host này nên chữ ký hợp lệ; ExternalUseSsl=true vì Caddy phục vụ qua HTTPS.
Minio__ExternalEndpoint=s3.operix.fun
Minio__ExternalUseSsl=true

# CORS — chỉ cho phép origin UI production
Cors__AllowedOrigins__0=https://app.operix.fun

# ===== Compliance LLM/OCR qua CLIProxyAPI (OAuth Claude Pro, không tốn token) =====
# Key client gửi cho proxy — PHẢI khớp api-keys trong llmproxy/config.yaml.
OPERIX_LLM_API_KEY=doi-thanh-key-manh-o-day
# Trỏ thẳng tới service proxy nội bộ (tên service trong compose, KHÔNG phải localhost).
# Bỏ trống dòng này nếu muốn gọi thẳng Anthropic bằng API key trả tiền.
ComplianceAutoUpdate__Llm__BaseUrl=http://llmproxy:8317
